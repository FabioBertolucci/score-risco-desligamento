# Chave da API da Anthropic (console.anthropic.com > API Keys). Paga pela empresa.
ANTHROPIC_API_KEY=
# Senha única que os analistas usam para entrar. Troque periodicamente.
APP_PASSWORD=
# Texto aleatório longo para assinar o login (ex.: saída de `openssl rand -hex 32`).
SESSION_SECRET=
# Pasta onde fica o banco SQLite. Precisa ser um disco persistente.
DATA_DIR=./data
PORT=3000
NODE_ENV=production
